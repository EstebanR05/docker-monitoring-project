{
  "id": null,
  "uid": "nginx-load-balancer",
  "title": "Nginx Load Balancer",
  "tags": ["nginx", "load-balancer"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Active Connections",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "nginx_connections_active",
          "legendFormat": "Active"
        },
        {
          "refId": "B",
          "expr": "nginx_connections_reading",
          "legendFormat": "Reading"
        },
        {
          "refId": "C",
          "expr": "nginx_connections_writing",
          "legendFormat": "Writing"
        },
        {
          "refId": "D",
          "expr": "nginx_connections_waiting",
          "legendFormat": "Waiting"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Accepted / Handled Connections (conn/s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(nginx_connections_accepted[1m])",
          "legendFormat": "Accepted"
        },
        {
          "refId": "B",
          "expr": "rate(nginx_connections_handled[1m])",
          "legendFormat": "Handled"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "cps" },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Requests per Second",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(nginx_http_requests_total[1m])",
          "legendFormat": "Requests/sec"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      }
    }
  ]
}
